---
import Base from '../../layouts/Base.astro';
import { getCategories, getSite, getSites, href } from '../../lib/atlas';

export function getStaticPaths() {
  return getSites().map((site) => ({ params: { site: site.id } }));
}

const site = getSite(Astro.params.site);
const categories = await getCategories(site.id);
---
<Base title={site.name} description={site.description} site={site}>
  <h1>{site.name}</h1>
  <p class="muted">{site.description}</p>

  <ul class="cards">
    {categories.map((c) => {
      const starred = c.links.filter((l) => l.starred).length;
      return (
        <li>
          <a class="card" href={href(`${site.id}/${c.id}/`)}>
            <h2>{c.title}</h2>
            <p class="muted">{c.description}</p>
            <span class="muted small">
              {c.links.length} links{starred > 0 && <> · <span class="star">★</span> {starred}</>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .small {
    font-size: 0.85rem;
  }
</style>
